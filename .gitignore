# Dependencies
node_modules/
vendor/
backend/vendor/
frontend/node_modules/

# Environment files
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Laravel storage and caches
backend/storage/*.key
backend/storage/pail
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*.log
!backend/storage/logs/.gitignore
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore
backend/public/build
backend/public/hot
backend/public/storage

# Frontend build outputs
frontend/dist/
frontend/dist-ssr/
frontend/.vitest-attachments/
frontend/**/__screenshots__/
*.local

# Tests and caches
.phpunit.result.cache
.phpunit.cache

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and Editor files
.DS_Store
Thumbs.db
.idea/
