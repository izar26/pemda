  "2": {
    "title": "KATEGORI RISIKO",
    "headers": [
      "NO",
      "KATEGORI RISIKO",
      "KODE",
      "DEFINISI"
    ],
    "rows": [
      {
        "NO": 1,
        "KATEGORI RISIKO": "Risiko Pendapatan",
        "KODE": "RP",
        "DEFINISI": "Risiko yang disebabkan oleh tidak tercapainya target pendapatan daerah. Pendapatan meliputi Pendapatan Asli Daerah, Pendapatan Transfer dan Pendapatan daerah lainnya."
      },
      {
        "NO": 2,
        "KATEGORI RISIKO": "Risiko Belanja",
        "KODE": "RB",
        "DEFINISI": "Risiko yang disebabkan oleh kegagalan dalam penyerapan belanja daerah, tidak sesuai proyeksi (porsionalitas penyerapan), atau tidak sesuai dengan sasaran penggunaan modal, barang, pegawai, transfer, bantuan sosial dan lain-lain."
      },
      {
        "NO": 3,
        "KATEGORI RISIKO": "Risiko Pembiayaan",
        "KODE": "RPb",
        "DEFINISI": "Risiko yang disebabkan oleh kegagalan dalam pembayaran/pemenuhan pembiayaan baik secara nominal maupun jadwal pembiayaan."
      },
      {
        "NO": 4,
        "KATEGORI RISIKO": "Risiko Strategis",
        "KODE": "RS",
        "DEFINISI": "Risiko yang disebabkan oleh ketidaktepatan organisasi dalam mengambil keputusan strategis, ketidaktepatan dalam memilih strategi dan program, serta kegagalan dalam mengantisipasi perubahan lingkungan organisasi berupa perubahan lingkungan organisasi berupa perubahan sosial, politik dan ekonomi."
      },
      {
        "NO": 5,
        "KATEGORI RISIKO": "Risiko Fraud",
        "KODE": "RF",
        "DEFINISI": "Risiko yang timbul karena kecurangan yang disengaja yang dapat merugikan keuangan negara termasuk dalam penggelapan aset (barang dan setara kas), korupsi (pungutan liar, gratifikasi, suap dan lain-lain) dan manipulasi laporan kinerja dan keuangan."
      },
      {
        "NO": 6,
        "KATEGORI RISIKO": "Risiko Kepatuhan",
        "KODE": "RK",
        "DEFINISI": "Risiko yang timbul akibat organisasi yang tidak mematuhi dan/atau tidak melaksanakan peraturan perundang-undangan dan ketentuan yang berlaku yang timbul karena kurangnya pemahaman terhadap hukum dan aturan lainnya yang berlaku umum."
      },
      {
        "NO": 7,
        "KATEGORI RISIKO": "Risiko Operasional",
        "KODE": "RO",
        "DEFINISI": "Risiko yang disebabkan oleh ketidakcukupan dan/atau tidak berfungsinya proses pelaksanaan kerja internal, kesalahan manusia dan kegagalan sistem, dan/atau adanya kejadian eksternal yang berpengaruh kepada operasional organisasi serta adanya tuntutan hukum dari luar organisasi."
      },
      {
        "NO": 8,
        "KATEGORI RISIKO": "Risiko Reputasi",
        "KODE": "RR",
        "DEFINISI": "Risiko yang disebabkan oleh penurunan tingkat kepercayaan pemangku kepentingan eksternal yang bersumber dari persepsi negatif terhadap organisasi."
      }
    ]
  },
